# Gunakan path absolut folder OneDrive pada komputer produksi.
# Nilai dapat berupa file .xlsx atau folder; jika folder, UPJKP_DB.xlsx akan digunakan.
ONEDRIVE_DATABASE_PATH=data/UPJKP_DB.xlsx
ONEDRIVE_DOCUMENT_PATH=documents
UPJKP_BACKUP_PATH=data/backup
UPJKP_HOST=127.0.0.1
UPJKP_PORT=8765
UPJKP_BACKUP_RETENTION=30
UPJKP_DEMO_MODE=false
